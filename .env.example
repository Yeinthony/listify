# URL base del backend Listify.
# SIN prefijo /api/v1: el backend no aplica setGlobalPrefix (ver docs/adr/0006).
# En dispositivo físico usá la IP de tu LAN (no localhost) y el backend en la misma red.
EXPO_PUBLIC_API_URL=http://192.168.1.28:3000

# Access Token de LocationIQ (https://locationiq.com) para autocompletado de direcciones
# al guardar ubicaciones. Free tier: 5.000 req/día, sin tarjeta.
EXPO_PUBLIC_LOCATIONIQ_KEY=
